# Puertos HTTP / HTTPS para pedir la página y sacar título/versión.
HTTP_PORTS = {80, 81, 3000, 5000, 7001, 8000, 8008, 8080, 8081, 8086, 8161,
              8888, 9000, 9090, 9200, 10000, 15672, 2375}
HTTPS_PORTS = {443, 8443, 9443, 2376, 6443}

# Riesgos conocidos por puerto (nivel, motivo).
DANGEROUS = {
