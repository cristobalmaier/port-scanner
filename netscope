def next_steps(ip, results):
    steps = []
    seen = set()
    for item in results:
        port = item["port"]
        cmds = []
        if port in WEB_PORTS:
            scheme = "https" if port in HTTPS_PORTS else "http"
            url = f"{scheme}://{ip}" if port in (80, 443) else f"{scheme}://{ip}:{port}"
            cmds += [f"whatweb {url}",
                     f"gobuster dir -u {url} -w /usr/share/wordlists/dirb/common.txt",
                     f"nikto -h {url}"]
        cmds += NEXT_STEPS.get(port, [])
        unique = []
        for cmd in cmds:
            cmd = cmd.format(ip=ip)
            if cmd not in seen:
                seen.add(cmd)
                unique.append(cmd)
        if unique:
            steps.append((port, unique))
    return steps


def print_next_steps(ip, results):
    steps = next_steps(ip, results)
    if not steps:
        return
    print(color("\n  Próximos pasos sugeridos", BOLD + CYAN))
    print(color("  " + "─" * 62, GRAY))
    for port, cmds in steps:
        service = SERVICES.get(port, "unknown")
        print(color(f"  {port}/tcp  {service}", BOLD + WHITE))
        for cmd in cmds:
            print(f"      {color('$', GREEN)} {cmd}")


def build_parser():
    p = argparse.ArgumentParser(
        prog="netscope",
        description="Recon rápido en un comando: todos los puertos + servicios/versiones.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""ejemplos:
  netscope 10.10.10.10                 escaneo completo (recomendado)
  netscope 10.10.10.10 --top 1000      solo los 1000 puertos más comunes
  netscope 10.10.10.10 -p 22,80,443    puertos concretos
""")
    p.add_argument("target", help="IP o hostname")
    p.add_argument("-p", "--ports", help="puertos: '22,80,443' o '1-1000'")
    p.add_argument("--top", type=int, default=0,
                   help="escanear solo los N puertos más comunes")
    p.add_argument("-t", "--timeout", type=float, default=0.7,
                   help="timeout por puerto (default 0.7)")
    p.add_argument("-T", "--threads", type=int, default=1000,
                   help="conexiones simultáneas (default 1000)")
    p.add_argument("--no-version", action="store_true",
                   help="solo descubrir puertos (saltar fases 2 y 3)")
    p.add_argument("-q", "--quiet", action="store_true", help="sin progreso")
    return p


COMMON = [21, 22, 23, 25, 53, 80, 110, 111, 135, 139, 143, 161, 389, 443, 445,
          465, 587, 631, 636, 873, 993, 995, 1433, 1521, 2049, 2181, 2375, 3000,
          3306, 3389, 5432, 5601, 5672, 5900, 5984, 6379, 6443, 8000, 8008,
          8080, 8081, 8443, 8888, 9000, 9090, 9200, 10000, 11211, 27017]


def parse_ports(args):
    if args.ports:
        ports = set()
        for chunk in args.ports.split(","):
            chunk = chunk.strip()
            if "-" in chunk:
                a, b = chunk.split("-", 1)
                ports.update(range(int(a), int(b) + 1))
            elif chunk:
                ports.add(int(chunk))
        return sorted(p for p in ports if 1 <= p <= 65535)
    if args.top > 0:
        return COMMON[: args.top]
    return list(range(1, 65536))


def main():
    args = build_parser().parse_args()

    try:
        ip = socket.gethostbyname(args.target)
    except socket.gaierror:
        print(color("[!] No se pudo resolver: ", RED) + args.target)
        return 1

    ports = parse_ports(args)
    verbose = not args.quiet and sys.stdout.isatty()
    print(color(f"\n  netscope — {args.target} ({ip})", BOLD + CYAN))
    print(color(f"  Fase 1/2 · descubriendo puertos abiertos ({len(ports)})...\n", GRAY))

    start = time.time()
    try:
        open_ports = asyncio.run(discover(ip, ports, args.timeout, args.threads, verbose))
    except KeyboardInterrupt:
        print("\n  Interrumpido.")
        return 130
    elapsed1 = time.time() - start

    if not open_ports:
        print(color("  No se encontraron puertos abiertos.", YELLOW))
        return 0
    print(color(f"\n  [+] Abiertos: {', '.join(map(str, open_ports))}  "
                f"({len(open_ports)} en {elapsed1:.1f}s)\n", GREEN))

    if args.no_version:
        return 0

    print(color(f"  Fase 2/2 · servicio/versión + chequeos activos de {len(open_ports)} puertos...\n", GRAY))
    results = []
    with ThreadPoolExecutor(max_workers=min(32, len(open_ports))) as pool:
        for item in pool.map(lambda p: enrich(ip, p, args.timeout), open_ports):
            results.append(item)
    results.sort(key=lambda r: r["port"])

    print_table(results)

    total = time.time() - start
    print(color(f"\n  Listo: {len(results)} puertos abiertos en {total:.1f}s", GREEN))

    print_next_steps(ip, results)

    return 0


if __name__ == "__main__":
    sys.exit(main())
