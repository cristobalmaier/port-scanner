# ── Parser de versión a partir de banners ────────────────────────────────────
_PATTERNS = [
    re.compile(r"SSH-\d+\.\d+-(?P<product>[\w.\-]+?)[_/ ](?P<ver>[\w.]+)", re.I),
    re.compile(r"(?P<product>vsFTPd|ProFTPD|Pure-FTPd)[ /](?P<ver>[\w.]+)", re.I),
    re.compile(r"(?P<product>nginx)/(?P<ver>[\w.]+)", re.I),
    re.compile(r"(?P<product>Apache)/(?P<ver>[\d.]+)", re.I),
    re.compile(r"(?P<product>Microsoft-IIS)/(?P<ver>[\d.]+)", re.I),
    re.compile(r"(?P<product>Postfix|Exim|Sendmail)[ /](?P<ver>[\w.\-]+)", re.I),
    re.compile(r"redis_version:(?P<ver>[\w.\-]+)", re.I),
    re.compile(r"(?P<product>MySQL|MariaDB)[ -]?(?P<ver>\d[\w.\-]*)", re.I),
    re.compile(r"(?P<product>SimpleHTTP)/(?P<ver>[\w.]+)", re.I),
]


def parse_version(text):
    for rx in _PATTERNS:
        m = rx.search(text or "")
        if m:
            g = m.groupdict()
            return (g.get("product") or "").strip(), (g.get("ver") or "").strip()
    return "", ""


def first_line(data):
    return data.decode("utf-8", "ignore").replace("\r", "").split("\n")[0].strip()


# ── Fase 1: descubrimiento de puertos (asíncrono, rápido) ────────────────────
async def _probe(ip, port, timeout, sem):
    async with sem:
        loop = asyncio.get_running_loop()
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.setblocking(False)
        try:
            await asyncio.wait_for(loop.sock_connect(sock, (ip, port)), timeout)
            return port
        except (asyncio.TimeoutError, OSError):
            return None
        finally:
            sock.close()


async def discover(ip, ports, timeout, threads, verbose):
    sem = asyncio.Semaphore(threads)
    open_ports = []
    tasks = [_probe(ip, p, timeout, sem) for p in ports]
    for coro in asyncio.as_completed(tasks):
        port = await coro
        if port is not None:
            open_ports.append(port)
            if verbose:
                print(f"  {port}/tcp open  ({SERVICES.get(port, 'unknown')})")
    return sorted(open_ports)


# ── Fase 2: detección de servicio/versión (hilos, bloqueante) ────────────────
def _connect(ip, port, timeout, tls=False):
    sock = socket.create_connection((ip, port), timeout=timeout)
    sock.settimeout(timeout)
    if tls:
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        try:
            ctx.set_alpn_protocols(["http/1.1"])
        except NotImplementedError:
            pass
        sock = ctx.wrap_socket(sock, server_hostname=ip)
    return sock


def _recv(sock, timeout):
    sock.settimeout(timeout)
    data = b""
    while len(data) < 8192:
        try:
            chunk = sock.recv(4096)
        except (socket.timeout, TimeoutError, OSError):
            break
        if not chunk:
            break
        data += chunk
        if len(data) >= 1024:
            break
    return data


def _tls_info(sock):
    try:
        version = sock.version()
        cipher = (sock.cipher() or ("",))[0]
        der = sock.getpeercert(binary_form=True)
    except Exception:
        return ""
    info = f"{version} · {cipher}"
    if der:
        try:
            with tempfile.NamedTemporaryFile("w", suffix=".pem", delete=False) as fh:
                fh.write(ssl.DER_cert_to_PEM_cert(der))
                path = fh.name
            cert = ssl._ssl._test_decode_cert(path)  # type: ignore[attr-defined]
            os.unlink(path)
            cn = ""
            for rdn in cert.get("subject", ()):
                for k, v in rdn:
                    if k == "commonName":
                        cn = v
            if cn:
                info += f" · CN={cn}"
            if cert.get("notAfter"):
                info += f" · expira {cert['notAfter']}"
        except Exception:
            pass
    return info


def enrich(ip, port, timeout):
    service = SERVICES.get(port, "unknown")
    product = version = banner = tls = ""
    http = {}

    if port in HTTPS_PORTS:
        try:
            sock = _connect(ip, port, timeout, tls=True)
            tls = _tls_info(sock)
            if port in HTTPS_PORTS:
                sock.sendall(b"GET / HTTP/1.0\r\nHost: " + ip.encode() + b"\r\n\r\n")
                text = _recv(sock, 0.8).decode("utf-8", "ignore")
                http = _parse_http(text)
            sock.close()
        except Exception:
            pass
    else:
        try:
            sock = _connect(ip, port, timeout)
            raw = _recv(sock, 0.6)
            if not raw:
                probe = b"GET / HTTP/1.0\r\n\r\n" if port in HTTP_PORTS else b"\r\n"
                sock.sendall(probe)
                raw = _recv(sock, 0.8)
            sock.close()
            banner = first_line(raw)[:90]
            if port in HTTP_PORTS:
                http = _parse_http(raw.decode("utf-8", "ignore"))
        except Exception:
            pass

    source = http.get("server", "") or banner
    product, version = parse_version(source)
    if not product:
        product, version = parse_version(banner)

    item = {"port": port, "service": service, "product": product,
            "version": version, "banner": banner, "tls": tls, "http": http}
    item["checks"] = active_checks(ip, port, timeout, item)
    return item


def _parse_http(text):
    out = {"headers": {}}
    text = text or ""
    head = re.split(r"\r?\n\r?\n", text, maxsplit=1)[0]
    m = re.search(r"^HTTP/[\d.]+ (\d{3})", head, re.M)
    if m:
        out["status"] = int(m.group(1))
    for name, value in re.findall(r"^([A-Za-z0-9\-]+):\s*(.*)$", head, re.M):
        out["headers"].setdefault(name.lower(), value.strip())
    if out["headers"].get("server"):
        out["server"] = out["headers"]["server"]
    m = re.search(r"<title[^>]*>(.*?)</title>", text, re.I | re.S)
    if m:
        out["title"] = re.sub(r"\s+", " ", m.group(1)).strip()[:90]
    return out


# ── Fase 3: chequeos activos (confirman vulns típicas) ───────────────────────
def _http_get(ip, port, timeout, tls=False, path="/"):
    sock = _connect(ip, port, timeout, tls=tls)
    req = (f"GET {path} HTTP/1.0\r\nHost: {ip}\r\n"
           f"User-Agent: netscope\r\nConnection: close\r\n\r\n")
    sock.sendall(req.encode())
    data = _recv(sock, 1.0)
    sock.close()
    return data.decode("utf-8", "ignore")


def _check_ftp(ip, timeout):
    sock = _connect(ip, 21, timeout)
    _recv(sock, 0.6)
    sock.sendall(b"USER anonymous\r\n")
    r1 = _recv(sock, 0.6).decode("utf-8", "ignore")
    sock.sendall(b"PASS anonymous@example.com\r\n")
    r2 = _recv(sock, 0.6).decode("utf-8", "ignore")
    sock.sendall(b"QUIT\r\n")
    sock.close()
    if "230" in r2:
        return "FTP permite login ANÓNIMO (sin credenciales)"
    if "331" in r1:
        return "FTP pide contraseña (probá anonymous)"
    return None


def _check_redis(ip, timeout):
    sock = _connect(ip, 6379, timeout)
    sock.sendall(b"PING\r\n")
    r = _recv(sock, 0.6).decode("utf-8", "ignore")
    sock.close()
    if "+PONG" in r:
        return "Redis SIN contraseña (responde PING)"
    if "NOAUTH" in r or "AUTH" in r:
        return "Redis requiere contraseña"
    return None


def _check_vnc(ip, timeout):
    sock = _connect(ip, 5900, timeout)
    ver = _recv(sock, 0.6)
    if not ver.startswith(b"RFB"):
        sock.close()
        return None
    sock.sendall(ver)
    data = _recv(sock, 0.6)
    sock.close()
    if len(data) >= 2 and data[1] == 1:
        return "VNC SIN autenticación"
    if data and data[0] >= 1:
        return "VNC pide contraseña"
    return None


def _check_elasticsearch(ip, timeout):
    text = _http_get(ip, 9200, timeout)
    if "You Know, for Search" in text or '"cluster_name"' in text:
        return "Elasticsearch accesible SIN autenticación"
    if text.split("\n", 1)[0].endswith("401 Unauthorized"):
        return "Elasticsearch requiere autenticación"
    return None


def _check_docker(ip, timeout):
    text = _http_get(ip, 2375, timeout)
    if '"ApiVersion"' in text or '"Version"' in text:
        return "Docker API EXPUESTA sin auth (control del host)"
    return None


def _bson_doc(fields):
    body = b""
    for name, value in fields:
        body += b"\x10" + name.encode() + b"\x00" + struct.pack("<i", value)
    body += b"\x00"
    return struct.pack("<i", len(body) + 4) + body


def _mongo_query(ip, timeout, db, fields):
    payload = db.encode() + b".$cmd\x00"
    payload += struct.pack("<i", 0)      # numberToSkip
    payload += struct.pack("<i", -1)     # numberToReturn
    payload += _bson_doc(fields)
    header = struct.pack("<iiii", 16 + len(payload), 1, 0, 2004)  # OP_QUERY
    sock = _connect(ip, 27017, timeout)
    sock.sendall(header + payload)
    data = b""
    while len(data) < 16:
        chunk = sock.recv(16 - len(data))
        if not chunk:
            break
        data += chunk
    if len(data) < 16:
        sock.close()
        return None
    length = struct.unpack("<i", data[0:4])[0]
    while len(data) < length:
        chunk = sock.recv(length - len(data))
        if not chunk:
            break
        data += chunk
    sock.close()
    return data.decode("latin-1", "ignore")


def _check_mongo(ip, timeout):
    body = _mongo_query(ip, timeout, "admin", [("listDatabases", 1)])
    if not body:
        return None
    if "databases" in body:
        return "MongoDB SIN autenticación (listDatabases accesible)"
    if "unauthorized" in body.lower():
        return "MongoDB requiere autenticación"
    return None


SECURITY_HEADERS = {
    "content-security-policy": "CSP",
    "x-frame-options": "X-Frame-Options",
    "x-content-type-options": "X-Content-Type-Options",
}


def _check_headers(item):
    headers = (item.get("http") or {}).get("headers")
    if not headers:
        return None
    want = dict(SECURITY_HEADERS)
    if item["port"] in HTTPS_PORTS:
        want["strict-transport-security"] = "HSTS"
    missing = [label for key, label in want.items() if key not in headers]
    if missing:
        return "Faltan cabeceras de seguridad: " + ", ".join(missing)
    return None


CHECKERS = {
    21: _check_ftp,
    2375: _check_docker,
    5900: _check_vnc,
    6379: _check_redis,
    9200: _check_elasticsearch,
    27017: _check_mongo,
}


def active_checks(ip, port, timeout, item):
    findings = []
    checker = CHECKERS.get(port)
    if checker:
        try:
            finding = checker(ip, timeout)
            if finding:
                findings.append(finding)
        except Exception:
            pass
    try:
        finding = _check_headers(item)
        if finding:
            findings.append(finding)
    except Exception:
        pass
    return findings


# ── Salida ───────────────────────────────────────────────────────────────────
RESET, BOLD, GRAY = "\033[0m", "\033[1m", "\033[90m"
RED, GREEN, YELLOW, CYAN, WHITE = "\033[91m", "\033[92m", "\033[93m", "\033[96m", "\033[97m"


def color(text, code):
    return f"{code}{text}{RESET}" if sys.stdout.isatty() else text


def version_string(item):
    v = " ".join(x for x in (item["product"], item["version"]) if x).strip()
    extra = ""
    if item["http"].get("title"):
        extra = f'"{item["http"]["title"]}"'
    elif item["tls"]:
        extra = item["tls"]
    if extra:
        v = f"{v} — {extra}" if v else extra
    return v


def print_table(results):
    print(color(f"  {'PUERTO':<12}{'SERVICIO':<16}VERSIÓN", GRAY))
    print(color("  " + "─" * 62, GRAY))
    for item in results:
        label = f"{item['port']}/tcp"
        service = f"{item['service']:<16}"
        row = (f"  {color(f'{label:<12}', BOLD + WHITE)}"
               f"{color(service, CYAN)}"
               f"{color(version_string(item), GRAY)}")
        print(row)
        findings = item.get("checks", [])
        if item["port"] in DANGEROUS and not findings:
            level, reason = DANGEROUS[item["port"]]
            col = RED if level == "CRITICAL" else YELLOW
            print(f"       {color('[' + level + ']', BOLD + col)} {reason}")
        for finding in findings:
            print(f"       {color('[!]', BOLD + YELLOW)} {color(finding, YELLOW)}")


