#!/usr/bin/env python3
"""
netscope — recon rápido en un solo comando.

Reemplaza el flujo típico de dos pasos:

    sudo nmap -p- --open -sS --min-rate 5000 -n -Pn -vv <IP> -oG allPorts
    nmap -sCV -p<PUERTOS> <IP> -oN targeted

con:

    netscope <IP>

Hace las dos fases (descubrir todos los puertos + detectar servicio/versión),
te muestra una tabla fácil de leer y guarda los resultados en una carpeta para
seguir con la auditoría.

Solo biblioteca estándar (Python 3.10+). Escaneá únicamente sistemas que te
pertenezcan o para los que tengas autorización por escrito.
"""

import argparse
import asyncio
import os
import re
import socket
import ssl
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor

